# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_RANDOM_48_BYTE_SECRET

# Optional WebRTC TURN relay for mobile networks.
# DNS record must point to the TURN server directly, without an HTTP proxy.
# NIGHTWELL_TURN_URL=turn:turn.nightwell.fun:3478?transport=udp,turn:turn.nightwell.fun:3478?transport=tcp
# NIGHTWELL_TURN_SHARED_SECRET=GENERATE_A_DIFFERENT_RANDOM_48_BYTE_SECRET
# Legacy static auth alternative (not recommended):
# NIGHTWELL_TURN_USERNAME=nightwell
# NIGHTWELL_TURN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
